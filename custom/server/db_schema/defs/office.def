{
   "datasource": "myworld",
   "name": "office",
   "external_name": "Office",
   "title": "{display_name}: [id]",
   "short_description": null,
   "track_changes": true,
   "versioned": false,
   "geom_indexed": true,
   "editable": {
      "insert_from_gui": true,
      "update_from_gui": true,
      "delete_from_gui": true
   },
   "editor_options": null,
   "fields": [
      {
         "name": "id",
         "external_name": "Id",
         "type": "integer",
         "key": true,
         "generator": "sequence"
      },
      {
         "name": "location",
         "external_name": "Location",
         "type": "point",
         "mandatory": "true"
      },
      {
         "name": "name",
         "external_name": "Name",
         "type": "string(256)"
      },
      {
         "name": "pin",
         "external_name": "Pin",
         "type": "integer"
      },
      {
         "name": "title",
         "external_name": "Title",
         "type": "string(32)",
         "validators": [
            {
               "message": "\"Title cannot be named as iqgeo\"",
               "expression": " [title] = 'iqgeo'"
            }
         ]
      },
      {
         "name": "comment_details",
         "external_name": "Comment Details",
         "type": "string(64)",
         "enum": "request_type",
         "mandatory": "[comment_details] = 'Feedback' | [comment_details] = 'Complaint'"
      }
   ],
   "groups": [],
   "searches": [],
   "queries": [
      {
         "value": "office",
         "description": "Office",
         "lang": "en"
      }
   ],
   "filters": []
}