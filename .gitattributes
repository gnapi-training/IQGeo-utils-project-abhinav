# Force LF line endings for files that run inside Linux containers
* text=auto eol=lf

# Explicitly enforce LF for shell scripts and configs
*.sh text eol=lf
*.bash text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
dockerfile* text eol=lf
entrypoint* text eol=lf

# Windows-native files can keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
